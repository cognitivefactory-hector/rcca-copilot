# Copy to .env and fill in. The real .env is gitignored — NEVER commit secrets.

# --- Claude / Anthropic (needed from M3 onward) ---
ANTHROPIC_API_KEY=

# --- Local dev ---
# Host port for the web app; override if 8000 is taken (e.g. WEB_PORT=8001).
WEB_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Postgres ---
POSTGRES_DB=rcca
POSTGRES_USER=rcca
POSTGRES_PASSWORD=rcca
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
